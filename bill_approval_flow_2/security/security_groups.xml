<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_bill_approval_flow" model="ir.module.category">
        <field name="name">Bill Approval</field>
        <field name="sequence">100</field>
    </record>

    <!-- Level 1 — e.g. Department Head -->
    <record id="group_bill_approver_l1" model="res.groups">
        <field name="name">L1 Approver (Department Head)</field>
        <field name="category_id" ref="module_bill_approval_flow"/>
    </record>

    <!-- Level 2 — e.g. Finance Manager -->
    <record id="group_bill_approver_l2" model="res.groups">
        <field name="name">L2 Approver (Finance Manager)</field>
        <field name="category_id" ref="module_bill_approval_flow"/>
    </record>

    <!-- Level 3 — e.g. Director / CFO -->
    <record id="group_bill_approver_l3" model="res.groups">
        <field name="name">L3 Approver (Director / CFO)</field>
        <field name="category_id" ref="module_bill_approval_flow"/>
    </record>
    <record id="group_create_entry" model="res.groups">
        <field name="name">Create Entry</field>
        <field name="category_id" ref="module_bill_approval_flow"/>
    </record>
    <record id="group_see_own_record" model="res.groups">
        <field name="name">See Own Entry</field>
        <field name="category_id" ref="module_bill_approval_flow"/>
    </record>

    <record id="rule_bill_approval_own_records" model="ir.rule">
    <field name="name">Bill Approval - Own Records Only</field>
    <field name="model_id" ref="model_bill_approval"/>
    <field name="groups" eval="[(4, ref('bill_approval_flow_2.group_see_own_record'))]"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
</record>
    <record id="rule_bill_approval_all_access" model="ir.rule">
    <field name="name">Bill Approval - All Access</field>
    <field name="model_id" ref="model_bill_approval"/>
    <field name="groups" eval="[
        (4, ref('bill_approval_flow_2.group_bill_approver_l1')),
        (4, ref('bill_approval_flow_2.group_bill_approver_l2')),
        (4, ref('bill_approval_flow_2.group_bill_approver_l3')),
        (4, ref('bill_approval_flow_2.group_create_entry'))
    ]"/>
    <field name="domain_force">[(1,'=',1)]</field>
</record>
</odoo>
