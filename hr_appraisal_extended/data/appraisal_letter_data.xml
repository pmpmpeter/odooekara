<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mail_appraisal_letters" model="mail.template">
            <field name="name">Appraisal Letter</field>
            <field name="model_id" ref="hr_appraisal_extended.model_self_rating"/>
            <!--            <field name="email_from">{{ object.company_id.email }}</field>-->
            <field name="email_to">{{object.employee_id.work_email}}</field>
            <field name="subject">Appraisal Letter</field>
            <field name="body_html" type="html">
                <div style="justify-content: center; padding:0.6rem;padding-left: 35px;text-decoration: none; font-size:13px;width: 100%;">
                    <h4 align="center">
                        <u>Confidential</u>
                    </h4>
                    <br/>
                    <br/>

                    <p>Date:
                        <t t-esc="datetime.date.today().strftime('%d-%m-%Y')"/>
                        <br/>
                        <br/>
                        <span style="font-weight:bold;">
                            Name:
                            <t t-out="object.employee_id.name"/>
                        </span>
                        <br/>
                        <span style="font-weight:bold;">Employee ID:
                            <t t-out="object.employee_id.id"/>
                        </span>
                        <br/>
                        <span style="font-weight:bold;">Designation:
                            <t t-out="object.designation"/>
                        </span>
                        <br/>
                        <br/>
                        <span style="font-weight:bold;">Subject :Letter of Increment and Salary Breakup Re-structure.
                        </span>
                        <br/>
                        <br/>


                        <span style="font-weight:bold;">Dear
                            <t t-out="object.employee_id.name"/>,
                        </span>
                        <br/>
                        <br/>
                        In recognition to your performance, we are pleased to inform you that your compensation has been
                        revised and you will be entitled to get the CTC of <b>Rs …….</b> per annum (Rupees …… only)
                        ,with effect from
                        <t t-out="object.appraisal_date.strftime('%d-%m-%Y') if object.appraisal_date else ''"/>
                        <br/>
                        <br/>

                        Your compensation is subject to tax deductions and other statutory levies as applicable. The
                        break-up of the compensation will be as per the Annexure given below.
                        <br/>
                        <br/>

                        All other terms and conditions of your employment remain unaltered. Your salary details are
                        strictly private and confidential and details in this letter must not be disclosed or discussed
                        with others.
                        <br/>
                        <br/>

                        Please acknowledge your acceptance of the revised terms by signing the duplicate copy of this
                        letter.

                        <br/>
                        <br/>
                        Thank you for being part of the <b>Ekara Partnership</b> Family.

                        <br/>
                        <br/>
                        With Best Wishes,
                        <br/>
                        <br/>
                        <b>
                            <t t-out="object.reviewer_id.name"/>
                            <br/>
                            <t t-out="object.reviewer_id.job_id.name"/>
                        </b>
                    </p>
                </div>
                <div style="justify-content: center; padding:0.6rem;padding-left: 35px;text-decoration: none; font-size:13px;width: 100%;">
                    <span style="float: right;">
                        <!--                        <img t-if="object.company_id.logo" t-att-src="image_data_uri(object.company_id.logo)" style="max-height: 60px;" alt="Logo"/>-->
                        <!--                        <img t-attf-src="image_data_uri(object.company_id.logo)" style="padding: 0px; margin: 0px; height: auto; width: 80px;" t-att-alt="object.company_id.name"/>-->
                    </span>
                    <br/>
                    <br/>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black; text-align: left;">
                        <tr>
                            <td colspan="3" style="border: 1px solid black; padding: 8px;height:100px;">
                                <h4 align="center">ANNEXURE</h4>
                                <br/>
                                <span style="font-weight:bold;">Name :
                                    <t t-out="object.employee_id.name"/>
                                </span>
                                <br/>
                                <span style="font-weight:bold;">Designation :
                                    <t t-out="object.designation"/>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3"
                                style="border: 1px solid black; padding: 8px;text-align: center;font-weight:bold;">
                                Salary Structure with effect from
                                <t t-out="object.appraisal_date.strftime('%d-%m-%Y') if object.appraisal_date else ''"/>
                            </td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <th style="border: 1px solid black; padding: 8px;">Particulars</th>
                            <th style="border: 1px solid black; padding: 8px;">Per Annum</th>
                            <th style="border: 1px solid black; padding: 8px;">Per Month</th>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Part - A (Fixed Pay)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Basic &amp; DA</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.basic_da or 0.0)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round(object.employee_id.contract_id.basic_da / 12))"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;House Rent Allowance</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.house_rent_allowance or 0.0)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round(object.employee_id.contract_id.house_rent_allowance / 12))"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Special Allowance</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.special_allowance or 0.0)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round(object.employee_id.contract_id.special_allowance / 12))"/>
                            </td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Sub-total (Part A)</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-set="a_annual_subtotal"
                                   t-value="(object.employee_id.contract_id.basic_da or 0.0)+ (object.employee_id.contract_id.house_rent_allowance or 0.0)+ (object.employee_id.contract_id.special_allowance or 0.0)"/>
                                <t t-esc="'{:,}'.format(a_annual_subtotal)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-set="a_monthly_subtotal"
                                   t-value="(round(object.employee_id.contract_id.basic_da / 12)) + (round(object.employee_id.contract_id.house_rent_allowance / 12)) + (round(object.employee_id.contract_id.special_allowance / 12))"/>
                                <t t-esc="'{:,}'.format(a_monthly_subtotal)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Part – B (Statutory
                                payments)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Statutory Bonus</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format((object.employee_id.contract_id.stat_bonus_amount or 0.0) * 12)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.stat_bonus_amount or 0.0)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Provident Fund (Employer's
                                Contribution)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format((object.employee_id.contract_id.provident_fund or 0.0) * 12)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.provident_fund or 0.0)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;ESIC (Employer's
                                Contribution)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format((object.employee_id.contract_id.esi_amount or 0.0) * 12)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.esi_amount or 0.0)"/>
                            </td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Sub-total (Part B)</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-set="annual_subtotal"
                                   t-value="(object.employee_id.contract_id.stat_bonus_amount or 0.0) * 12 + (object.employee_id.contract_id.provident_fund or 0.0) * 12 + (object.employee_id.contract_id.esi_amount or 0.0) * 12"/>
                                <t t-esc="'{:,}'.format(annual_subtotal)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-set="monthly_subtotal"
                                   t-value="(object.employee_id.contract_id.stat_bonus_amount or 0.0) + (object.employee_id.contract_id.provident_fund or 0.0) + (object.employee_id.contract_id.esi_amount or 0.0)"/>
                                <t t-esc="'{:,}'.format(monthly_subtotal)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Part – C (Performance
                                Linked Pay
                            </td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Variable Pay*</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-set="variable_pay_amount"
                                   t-value="object.employee_id.contract_id.variable_pay_amount or 0.0"/>
                                <t t-esc="'{:,}'.format(variable_pay_amount)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round(variable_pay_amount / 12))"/>
                            </td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Sub-total (Part C)</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-set="subtotal_c"
                                   t-value="variable_pay_amount"/>
                                <t t-esc="'{:,}'.format(subtotal_c)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round(variable_pay_amount / 12))"/>

                            </td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">TOTAL SALARY (A + B +
                                C)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format((object.employee_id.contract_id.basic_da or 0.0) +
                                 (object.employee_id.contract_id.house_rent_allowance or 0.0) +
                                 (object.employee_id.contract_id.special_allowance or 0.0) +
                                (object.employee_id.contract_id.stat_bonus_amount or 0.0) * 12 +
                                (object.employee_id.contract_id.provident_fund or 0.0) * 12 +
                                (object.employee_id.contract_id.esi_amount or 0.0) * 12 +
                                (object.employee_id.contract_id.variable_pay_amount or 0.0))"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round((object.employee_id.contract_id.basic_da or 0.0) / 12) +
                                 round((object.employee_id.contract_id.house_rent_allowance or 0.0) / 12) +
                                 round((object.employee_id.contract_id.special_allowance or 0.0) / 12)  +
                                (object.employee_id.contract_id.stat_bonus_amount or 0) +
                                (object.employee_id.contract_id.provident_fund or 0) +
                                (object.employee_id.contract_id.esi_amount or 0) +
                                round((object.employee_id.contract_id.variable_pay_amount or 0.0) / 12))"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Part D (Other
                                Benefits)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Medical Insurance **</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.medical_insurance or 0.0)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;">&#160;&#160;Group Personal Accidental
                                Insurance***
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(object.employee_id.contract_id.group_personal_accident_insurance or 0.0)"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Sub-total (Part D)</td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format((object.employee_id.contract_id.medical_insurance or 0.0) + (object.employee_id.contract_id.group_personal_accident_insurance or 0.0))"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">-</td>
                        </tr>
                        <tr style="background-color:#e7e6e6;">
                            <td style="border: 1px solid black; padding: 8px;font-weight:bold;">Total Cost to the
                                Company (A + B + C + D)
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format((object.employee_id.contract_id.basic_da or 0.0) +
                                 (object.employee_id.contract_id.house_rent_allowance or 0.0) +
                                 (object.employee_id.contract_id.special_allowance or 0.0) +
                                (object.employee_id.contract_id.stat_bonus_amount or 0.0) * 12 +
                                (object.employee_id.contract_id.provident_fund or 0.0) * 12 +
                                (object.employee_id.contract_id.esi_amount or 0.0) * 12 +
                                (object.employee_id.contract_id.variable_pay_amount or 0.0) +
                                (object.employee_id.contract_id.medical_insurance or 0.0) +
                                (object.employee_id.contract_id.group_personal_accident_insurance or 0.0))"/>
                            </td>
                            <td style="border: 1px solid black; padding: 8px;">
                                <t t-esc="'{:,}'.format(round((object.employee_id.contract_id.basic_da or 0.0) / 12) +
                                 round((object.employee_id.contract_id.house_rent_allowance or 0.0) / 12) +
                                 round((object.employee_id.contract_id.special_allowance or 0.0) / 12) +
                                (object.employee_id.contract_id.stat_bonus_amount or 0) +
                                (object.employee_id.contract_id.provident_fund or 0) +
                                (object.employee_id.contract_id.esi_amount or 0) +
                                round((object.employee_id.contract_id.variable_pay_amount or 0.0) / 12) +
                                round((object.employee_id.contract_id.medical_insurance or 0.0) / 12) +
                                round((object.employee_id.contract_id.group_personal_accident_insurance or 0.0) / 12))"/>

                            </td>
                        </tr>
                    </table>
                    <br/>
                    <br/>
                    * Payable as per the Variable Pay Policy of the Company
                    <br/>
                    <br/>
                    <br/>
                    <b>With Best Wishes,</b>
                    <br/>
                    <br/>
                    <b>
                        <t t-out="object.reviewer_id.name"/>
                        <br/>
                        <t t-out="object.reviewer_id.job_id.name"/>
                    </b>
                </div>
            </field>
        </record>
    </data>


</odoo>