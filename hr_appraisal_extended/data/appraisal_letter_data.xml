<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data >

        <record id="mail_appraisal_letters" model="mail.template">
            <field name="name">Appraisal Letter</field>
            <field name="model_id" ref="hr_appraisal_extended.model_hr_appraisal"/>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{object.employee_id.work_email}}</field>
            <field name="subject">Appraisal Letter</field>
            <field name="body_html" type="html">
                <div style="justify-content: center; padding:0.6rem;padding-left: 35px;text-decoration: none; font-size:13px;width: 100%;">
                    <h4 align="center"><u>Confidential</u></h4><br/>
                    <br/>

                    <p>Date:
                        <br/>
                        <br/>
                        <span style="font-weight:bold;">
                            Name:
                            <!--                            <t t-out="object.name"/>,-->
                        </span><br/>
                        <span style="font-weight:bold;">Employee ID:</span><br/>
                        <span style="font-weight:bold;">Designation:</span>
                        <br/>
                        <br/>
                        <span style="font-weight:bold;">Subject :Letter of Increment and Salary Breakup Re-structure.</span>
                        <br/>
                        <br/>


                        <span style="font-weight:bold;">Dear,</span>
                        <br/>
                        <br/>
                        In recognition to your performance, we are  pleased to inform you that your compensation has been revised and you will be entitled to get the CTC of <b>Rs …….</b> per annum (Rupees …… only) ,with effect from Month Date, Year
                        <br/><br/>

                        Your compensation is subject to tax deductions and other statutory levies as applicable. The break-up of  the compensation will be as per the Annexure given below.
                        <br/><br/>

                        All other terms and conditions of your employment remain unaltered. Your salary details are strictly private and confidential and details in this letter must not be disclosed or discussed with others.
                        <br/><br/>

                        Please acknowledge your acceptance of the revised terms by signing the duplicate copy of this letter.

                        <br/>
                        <br/>
                        Thank you for being part of the <b>Ekara Partnership</b> Family.

                        <br/>
                        <br/>
                        With Best Wishes,
                        <br/>
                        <br/>
                        <b>
                            Bhairavi M Shibulal<br/>
                            Director<br/>
                            Ekara Partnership,<br/>
                            Bangalore
                        </b>
                    </p>
                </div>
