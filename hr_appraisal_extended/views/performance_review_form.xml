<odoo>
    <record id="view_performance_review_form" model="ir.ui.view">
        <field name="name">performance.review.form</field>
        <field name="model">performance.review</field>
        <field name="arch" type="xml">
            <form string="Performance Review">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="preparation,preparation_clarification,half_year_pending,
                    half_year_clarification,full_year_pending,full_year_clarification,review_completed" nolabel="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="create_review_current_year"/>
                            <field name="create_review_previous_year"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="create_uid"/>
                            <field name="write_date"/>
                            <field name="write_uid"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goals">
                            <field name="goal_sets_kras">
                                <tree editable="bottom">
                                    <field name="goal_description"/>
                                    <field name="review_id"/>
                                    <field name="category"/>
                                    <field name="kra"/>
                                    <field name="goal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Review Comments">
                            <field name="goal_review_comments">
                                <tree editable="bottom">
                                    <field name="commented_by"/>
                                    <field name="comments"/>
                                    <field name="commented_date"/>
                                    <field name="need_response_from"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Others">
                            <group>
                                <field name="supporting_document"/>
                            </group>
                            <group>
                                <field name="action_needed"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_performance_review_tree" model="ir.ui.view">
        <field name="name">performance.review.tree</field>
        <field name="model">performance.review</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
            </tree>
        </field>
    </record>
    <!-- Action -->
    <record id="action_hr_performance_review" model="ir.actions.act_window">
        <field name="name">Performance Review</field>
        <field name="res_model">performance.review</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Create and manage performance review for employees.</p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_hr_performance_review" name="Performance Review"
              parent="hr_appraisal.menu_open_view_hr_appraisal_tree"
              sequence="1" action="action_hr_performance_review"/>
</odoo>
