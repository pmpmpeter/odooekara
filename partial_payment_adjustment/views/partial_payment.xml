<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_payment_form_inherited1" model="ir.ui.view">
            <field name="name">account.payment.form.inherited</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr='//sheet' position="inside">
                    <separator string="Invoices"/>
                    <field name="payment_invoice_ids" readonly="state not in ('draft','to approve','approved')">
                        <tree editable="bottom" create="false">
                            <field name="invoice_id" readonly="1" force_save="1"/>
                            <field name="date" readonly="1" force_save="1"/>
                            <field name="amount_total" sum="amount_total"/>
                            <field name="residual"/>
                            <field name="reconcile_amount" sum="reconcile_amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
