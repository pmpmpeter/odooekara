                            <td colspan="3" style="border: 1px solid black; padding: 8px; "></td>
                            <!--                            <td style="border: 1px solid black; padding: 8px; "></td>-->
                        </tr>
                        <tr>
                            <td colspan="5" style="border: 1px solid black; padding: 8px; height:100px;">Summarise the employee’s
                                performance and progress over the period
                            </td>
