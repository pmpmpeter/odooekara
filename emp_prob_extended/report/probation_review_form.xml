                            <td style="border: 1px solid black; padding: 8px; width: 50%;">Grade:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px; "></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; width: 50%;">Department / Section:</td>
