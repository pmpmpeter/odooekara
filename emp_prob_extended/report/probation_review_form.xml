<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_probation_form_pdf_A4" model="report.paperformat">
        <field name="name">NDA Form</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>
    <record id="report_probation_review_template" model="ir.actions.report">
        <field name="name">Probation Review</field>
        <field name="model">employee.probation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">emp_prob_extended.print_report_probation_review_form</field>
        <field name="report_file">emp_prob_extended.print_report_probation_review_form</field>
        <field name="paperformat_id" ref="emp_prob_extended.paperformat_probation_form_pdf_A4"/>
        <field name="print_report_name">'report_probation_review_form'</field>
        <field name="binding_model_id" ref="emp_prob_extended.model_employee_probation"/>
        <field name="binding_type">report</field>
    </record>


    <template id="print_report_probation_review_form">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <!--page1-->
                <div style="margin-left: 25px; margin-right: 25px;" class="page">
                    <h5 style="text-align: center; font-weight: bold; text-decoration: underline;">PROBATION REVIEW
                        FORM
                    </h5>
                    <P>Probation Record</P>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black; text-align: left;">
                        <tr>
                            <td style="border: 1px solid black; padding: 8px; ">Employee name:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px;"></td>
                        </tr>
                        <!-- Second Row -->
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;width: 50%;">Job Title:</td>
                            <td colspan="2" style="border: 1px solid black; padding: 8px;">
                                <!--                                <select style="width: 100%; padding: 4px;">-->
                                <!--                                    <option value="">Select...</option>-->
                                <!--                                </select>-->
                            </td>
                        </tr>
                        <!-- Additional Rows -->
