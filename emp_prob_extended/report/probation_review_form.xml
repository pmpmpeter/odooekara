                        </tr>
                        <tr>
                            <td style="border: 1px solid black; padding: 8px;"></td>
                            <td style="border: 1px solid black; padding: 8px; ">Date Due</td>
                            <td style="border: 1px solid black; padding: 8px; ">Please select Date when completed</td>
                        </tr>
