<odoo>
    <record id="view_project_form_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name='date_start' position="after">
                <field name="is_document_validity_management" invisible='1' force_save='1'/>
                <field name="document_type_id" invisible="not is_document_validity_management"/>
                <field name="validity_start_date" required="document_type_id or is_document_validity_management" invisible="not is_document_validity_management"/>
                <field name="validity_end_date" required="document_type_id or is_document_validity_management" invisible="not is_document_validity_management" />
            </field>
        </field>
    </record>

    <record id="view_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name='partner_id' position="after">
                <field name="is_document_validity_management" invisible='1'/>
                <field name="document_type_id" invisible="not is_document_validity_management" readonly='1'/>
                <field name="validity_start_date" required="document_type_id" invisible="not is_document_validity_management" readonly='1'/>
                <field name="validity_end_date" required="document_type_id" invisible="not is_document_validity_management" readonly='1'/>
            </field>
        </field>
    </record>

    <record id="edit_project_view_form_extend_inherit" model="ir.ui.view">
        <field name="name">project.project.form.extend.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_extended.edit_project_view_form_extend"/>
        <field name="arch" type="xml">
        <xpath expr="//div[@class='oe_title']/h1[@class='d-flex flex-row']" position="inside">
                <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" invisible="not is_document_validity_management" placeholder="Document Name"/>
                <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" invisible="is_legal_notice or is_statuory_notice or is_document_validity_management" placeholder="e.g. Office Party"/>
        </xpath>
            <xpath expr="//header" position="inside">
                <button name="document_closed" type="object" string="Closed" class="btn-primary" invisible="not is_document_validity_management"/>
            </xpath>
            <field name='tag_ids' position="after">
                <field name="closed_date" invisible="not is_document_validity_management"/>
                <field name="closed_by" invisible="not is_document_validity_management"/>
            </field>
        </field>
    </record>
 

    <record id="open_create_project_document_management" model="ir.actions.act_window">
        <field name="name">Document Validity Management</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_is_document_validity_management': True}</field>
        <field name="domain">[('is_document_validity_management', '=', True)]</field>
    </record>


     <menuitem id="document_validity_management_menu" name="Document Validity Management" sequence="3"
              parent="project_extended.open_create_project_menu" action="open_create_project_document_management"/>
</odoo>
