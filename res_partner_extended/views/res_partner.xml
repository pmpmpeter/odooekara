<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

                <record id="res_partner_flow_kanban_view" model="ir.ui.view">
                 <field name="name">res.partner.flow.kanban.view</field>
                 <field name="model">res.partner</field>
                 <field name="inherit_id" ref="base.res_partner_kanban_view"/>
                 <field name="arch" type="xml">
                    <xpath expr="//field[@name='mobile']" position="after">
                        <field name="state"/>
                    </xpath>
                 
                <xpath expr="//div[@class='oe_kanban_details d-flex flex-column justify-content-between']" position="inside">
                  <field name="state" widget="label_selection" 
                    options="{'classes': {'draft': 'default', 'done': 'default', 'approve': 'success'}}"/>
                    </xpath>
                 </field>
              </record>

        <record id="view_res_partner_filter_inerit" model="ir.ui.view">
            <field name="name">res.partner.search.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter" />
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="customer_code" string="Customer Code" />
                    <field name="vendor_code" string="Vendor Code"/>
                </xpath>
                <xpath expr="//filter[@name='customer']" position="after">
                   <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                   <filter string="To Validate" name="done" domain="[('state','=','done')]"/>
                   <filter string="Approved" name="approve" domain="[('state','=','approve')]"/>
                </xpath>
                <xpath expr="//search/group" position="inside">
                   <filter name="state" string="Status" domain="[]" context="{'group_by' : 'state'}"/>
                </xpath>
            </field>
        </record>

        <record id="res_partner_master_extend" model="ir.ui.view">
            <field name="name">res.partner.inherits</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position='before'>
                    <header>
                          <button name="action_validate" type="object" string="Validate" 
                            invisible="state != 'draft'" class="oe_highlight" 
                            groups="account.group_account_manager" />                    
                          <button name="action_approve" type="object" string="Approve" 
                            invisible="state != 'done'" class="oe_highlight" 
                            groups="account.group_account_manager"/>
                         <button name="reset_to_draft" type="object" 
                            string="Reset To Draft" invisible="state not in ['approve', 'done']" class="oe_highlight" 
                         groups="account.group_account_manager"/>
                          <field name="state" widget="statusbar"/>
                   </header>
                </xpath>
                <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='mobile']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='function']" position="attributes">
                     <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name='type']" position="attributes">
                   <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath> -->
                <!-- <xpath expr="//field[@name='type']" position="attributes">
                   <attribute name="attrs">{'invisible': [('is_company','=', True)], 'required': [('is_company','!=', True)], 'readonly': ['|',('user_ids', '!=', []), ('state', 'in',[('approve'),('done')])]}</attribute>
                </xpath> -->
                <xpath expr="//field[@name='is_company']" position="attributes">
                   <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@id='individual']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                    <attribute name="invisible">is_company</attribute>
                </xpath>
                <xpath expr="//field[@id='company']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                    <attribute name="invisible">not is_company</attribute>
                </xpath>
                <!-- <field name="parent_id" position="attributes">
                   <attribute name="attrs">{'invisible': ['|', '&amp;', ('is_company','=', True),('parent_id', '=', False),('company_name', '!=', False),('company_name', '!=', '')], 'readonly': [('state', 'in',[('approve'),('done')])]}</attribute>
                </field> -->
                <xpath expr="//field[@name='lang']" position="attributes">
                         <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="replace">
                   <field name="category_id" widget="many2many_tags" options="{'color_field': 'color','no_open': True, 'no_quick_create':True,'no_create': True}" readonly="state not in ['approve','done']" 
                    placeholder='e.g. "B2B", "VIP", "Consulting", ...'/>
                </xpath>
                <xpath expr="//field[@name='vat']" position="attributes">
                         <attribute name="invisible">1</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name='vat']" position="after">
                         <field name="vat" placeholder="e.g.11AAOAA0000AAAA" class="oe_inline"
                         attrs="{'required':[('l10n_in_gst_treatment', 'in', ['regular', 'composition', 'special_economic_zone', 'deemed_export'])],
                          'readonly': [('state', 'in',[('approve'),('done')])]}" string="GSTIN"/>
                </xpath> -->
                <xpath expr="//field[@name='property_account_receivable_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_quick_create':True,'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='property_account_payable_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_quick_create':True,'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='state_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_quick_create':True,'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='title']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_quick_create':True,'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='bank_ids']/tree/field[@name='bank_id']" position="attributes">
                 <attribute name="options">{'no_open': True, 'no_quick_create':True,'no_create': True}</attribute>
                </xpath>
                <!-- <xpath expr="//page[@name='accounting']/group/group[@name='credit_limits']" position="inside">
                    <field name="block_sales_credit" force_save='1' attrs="{'readonly': [('state', 'in',[('approve'),('done')])]}"/>
                </xpath> -->
                <!-- <xpath expr="//field[@name='use_partner_credit_limit']" position="attributes">
                         <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath> -->
                <xpath expr="//page[@name='accounting']/group//group[@name='accounting_entries']//field[@name='property_account_receivable_id']" position="attributes">
                    <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//page[@name='accounting']/group//group[@name='accounting_entries']//field[@name='property_account_payable_id']" position="attributes">
                         <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//page[@name='accounting']/group//group[@name='banks']//field[@name='bank_ids']" position="attributes">
                         <attribute name="readonly">state in ('approve', 'done')</attribute>
                </xpath>
                <xpath expr="//page[@name='sales_purchases']//field[@name='user_id']" position="before">
                     <field name="is_customer"/>
                     <field name="customer_code" invisible="is_customer != True"/>
                </xpath>
                <!-- <xpath expr="//field[@name='user_id']" position="attributes">
                 <attribute name="invisible">not is_customer</attribute>
                </xpath>
                <xpath expr="//field[@name='property_payment_term_id']" position="attributes">
                 <attribute name="invisible">not is_customer</attribute>
                </xpath> -->
                <!-- <xpath expr="//field[@name='property_inbound_payment_method_line_id']" position="attributes">
                 <attribute name="invisible">not is_customer</attribute>
                </xpath> -->
            </field>
        </record>
         <record id="purchase_property_extend" model="ir.ui.view">
            <field name="name">res.partner.inherits</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='buyer_id']" position="before">
                     <field name="is_vendor"/>
                     <field name="vendor_code" invisible="is_vendor != True"/>
                </xpath>
                <xpath expr="//field[@name='buyer_id']" position="attributes">
                <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='property_supplier_payment_term_id']" position="attributes">
                 <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name='property_outbound_payment_method_line_id']" position="attributes">
                 <attribute name="invisible">not is_vendor</attribute>
                </xpath> -->
                 <xpath expr="//label[@for='receipt_reminder_email']" position="attributes">
                 <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='receipt_reminder_email']" position="attributes">
                 <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                <xpath expr="//field[@name='property_purchase_currency_id']" position="attributes">
                 <attribute name="invisible">not is_vendor</attribute>
                </xpath>
                
            </field>
        </record>

        <record id="account.res_partner_action_customer" model="ir.actions.act_window">
          <field name="context">{'search_default_customer': 1,'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1, 'default_is_customer': True}</field>
        </record>
        <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
          <field name="context">{'search_default_supplier': 1,'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1, 'default_is_vendor': True}</field>
        </record>

    </data>
</odoo>
