<odoo>
    <record id="view_employee_indent_form" model="ir.ui.view">
        <field name="name">employee.indent.form</field>
        <field name="model">employee.indent</field>
        <field name="arch" type="xml">
            <form string="Employee Indent">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,waiting_approval,open,close"/>

                    <button name="action_approve" type="object" string="Approval" class="btn-primary"
                            invisible="status not in 'draft'"/>
                    <button name="action_open" type="object" string="Open" class="btn-secondary"
                            invisible="status not in 'waiting_approval'"/>
                    <button name="action_close" type="object" string="Close" class="btn-danger"
                            invisible="status not in 'open'"/>
                    <button name="action_reset" type="object" string="Reset To Draft" class="btn-light"
                            invisible="status in 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" options="{'line_breaks': False}" widget="text"
                                   placeholder="Employee Indent Name"  readonly="status not in ('draft','waiting_approval')"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Job Position Related">
                            <group>
                                <group>
                                    <field name="tax_entity" string="Tax Entity" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="organization" string="Organization" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="location" string="Location" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="department" string="Department" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="grade_job_level" string="Grade/ Job Level" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="position_name" string="Position Name / Designations" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                </group>
                                <group>
                                    <field name="reporting_to" string="Reporting To" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="employment_type" string="Employment Type" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="target" string="Target" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="is_replacement" string="Is Replacement?" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="replacement_employee_id" string="Replacement Employee Name"
                                           invisible="not is_replacement" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="expected_indent_closure_date" string="Expected Indent Closure Date"
                                           required="1" readonly="status not in ('draft','waiting_approval')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other Details">
                            <group>
                                <group string="Budget Details">
                                    <field name="currency_id" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="budgeting_unit" string="Budgeting Units" required="1" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="is_budgeted" string="Is Budgeted?" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" invisible="not is_budgeted" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="approved_budget" string="BU/Department Total Approved Budget" invisible="not is_budgeted" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="budgeted_amount" string="Budgeted Amount for Position" invisible="not is_budgeted" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="utilized_budget" string="Utilized Budget" invisible="not is_budgeted" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="balance_budget" string="Balance Budget" invisible="not is_budgeted" readonly="1"/>
                                </group>

                                <group string="Lead Details">
                                    <field name="unit_head_id" string="Unit Head" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="recruitment_spoc_mgr_id" string="Recruitment SPOC/Mgr" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="director_approval_id" string="Director Approval" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="survey_id" string="Survey Form" readonly="status not in ('draft','waiting_approval')"/>
                                </group>

                                <group string="Review">
                                    <field name="preferences" string="Preferences" readonly="status not in ('draft','waiting_approval')"/>
                                    <field name="notes" string="Notes" readonly="status not in ('draft','waiting_approval')"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_indent_tree" model="ir.ui.view">
        <field name="name">employee.indent.tree</field>
        <field name="model">employee.indent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="organization"/>
                <field name="location"/>
                <field name="department"/>
                <field name="employment_type"/>
                <field name="target"/>
                <field name="expected_indent_closure_date"/>
                <field name="budgeted_amount"/>
                <field name="utilized_budget"/>
                <field name="balance_budget"/>
                <field name="status" widget='badge' decoration-success="status == 'open'" decoration-info="status == 'draft'" decoration-danger="status =='close'"/>
            </tree>
        </field>
    </record>

    <record id="action_employee_indent" model="ir.actions.act_window">
        <field name="name">Employee Indent</field>
        <field name="res_model">employee.indent</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_employee_indent_tree"/>
        <field name="target">current</field>
    </record>

    <menuitem
            name="Employee Indents"
            parent="hr_recruitment.menu_crm_case_categ0_act_job"
            id="menu_employee_indent"
            sequence="2"
            action="action_employee_indent"/>
</odoo>

