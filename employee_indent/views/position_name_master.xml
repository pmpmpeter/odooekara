<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_position_names_view_tree" model="ir.ui.view">
            <field name="model">hr.position.names</field>
            <field name="arch" type="xml">
                <tree string="Position Names" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code" groups="base.group_no_one"/>
                </tree>
            </field>
        </record>

        <record id="hr_position_names_view_form" model="ir.ui.view">
            <field name="model">hr.position.names</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" groups="base.group_no_one"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="hr_position_names_action" model="ir.actions.act_window">
            <field name="name">Position Names</field>
            <field name="res_model">hr.position.names</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Position Names
                </p>
            </field>
        </record>

        <menuitem
        id="menu_hr_recruitment_position_names"
        action="hr_position_names_action"
        parent="hr_recruitment.menu_hr_recruitment_config_jobs"
        sequence="4"
        groups="hr.group_hr_user"/>
    </data>
</odoo>
