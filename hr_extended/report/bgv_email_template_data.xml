<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="mail_template_bgv" model="mail.template">
            <field name="name">BGV Email Template</field>
            <field name="model_id" ref="hr_extended.model_hr_employee"/>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="subject">Background Verification Email </field>
            <field name="body_html" type="html">
                <div >
                    <div style="justify-content: center; padding:0.6rem;padding-left: 35px;text-decoration: none; font-size:13px;width:40%">
                        <p>
                            Dear
                            <t t-out="object.name"/>,
                        </p>
                        <div>
                            <p>
                                Greetings for the day <br/>
                                Please find the details below pertaining to a New Joiner's BGV process to be initiated:<br/>

                                <br/> Name of the Employee -
                                <t t-out="object.name"/><br/>
                                Date of Joining -  <br/><br/>

                                <span><u>List of Documents shared:</u></span> <br/>
                                <ol>
                                    <li>Education Document – Highest or All Education Documents (Clear Copy)</li>
                                    <li>Employment Document – Relieving Letter and Service Letter (Previous Employment
                                        if any)
                                    </li>
                                    <li>Aadhaar Copy</li>
                                    <li>PAN Copy</li>
                                    <li>Complete Address with door number and PIN Code (Present &amp; Permanent)</li>
                                    <li>Candidate Father’s Name (from ATS)</li>
                                    <li>Candidate Date of Birth (from ATS)</li>
                                    <li>Employee Verification Form</li>
                                </ol>

                                Request you to kindly initiate the process at the earliest.<br/>

                            </p>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Thank you<br/>
                    With regards,

                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                </div>
            </field>
        </record>
    </data>
</odoo>
