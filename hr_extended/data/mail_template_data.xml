                    </tr>
                </table>
                <br>
                    * Payable as per the Variable Pay Policy of the Company
                </br>
                With Best Wishes,
                <br/>
                <br/>
                <b>
                    Bhairavi M Shibulal
                    <br/>
                    Director
                    <br/>
                    Ekara Partnership,
                    <br/>
                    Bangalore
                </b>
            </div>
        </field>
    </record>

</odoo>
