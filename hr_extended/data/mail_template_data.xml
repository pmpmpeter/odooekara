<?xml version="1.0" ?>
<odoo noupdate="0">
    <!--Email template -->
    <record id="job_creation_email_template" model="mail.template">
        <field name="name">Job Description Template</field>
        <field name="model_id" ref="hr_extended.model_employee_indent"/>
        <field name="email_to">{{object.director_approval_id.email}}</field>
        <field name="subject">Job Description Template
        </field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-out="object.director_approval_id.name or 'applicant'">[applicant name]</t>
                    <br/>
                    <div style="margin: 16px 0px 16px 0px;">
                        <t t-if="object.survey_id.title">
                            <a t-att-href="(object.get_survey_url())"
                               style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                Add Job Description Details
                            </a>
                        </t>
                        <t t-else="">
                            <span style="color: red; font-size: 13px;">
                                No survey added in the indent form
                            </span>
                        </t>
                    </div>
                </p>
            </div>
        </field>
        <field name="lang">{{ object.director_approval_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!--Pre-Employment Reference Check Survey form-->
    <record id="reference_check_survey_email_template" model="mail.template">
        <field name="name">Reference Check Survey Template</field>
        <field name="model_id" ref="hr_extended.model_hr_applicant"/>
        <field name="email_to">{{object.referred_by.email}}</field>
        <field name="subject">Reference Check Survey Form Template
        </field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-out="object.referred_by.name or 'applicant'">[applicant name]</t>
                    <br/>
                    <div style="margin: 16px 0px 16px 0px;">
                        <t t-if="object.pre_employment_survey.title">
                            <a t-att-href="(object.get_survey_url())"
                               style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                Add Reference Check Details
                            </a>
                        </t>
                        <t t-else="">
                            <span style="color: red; font-size: 13px;">
                                No survey added in the Reference Check form
                            </span>
                        </t>
                    </div>
                </p>
            </div>
        </field>
        <field name="lang">{{ object.referred_by.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>