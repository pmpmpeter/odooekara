<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="joining_documents_tree_view" model="ir.ui.view">
        <field name="name">joining.documents.tree</field>
        <field name="model">joining.documents</field>
        <field name="arch" type="xml">
            <tree string="Employee Joining Document">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_position_id"/>
                <field name="joining_date"/>
                <field name="state" widget='badge' decoration-info="state == 'waiting_confirmation'"
                       decoration-success="state =='done'" decoration-danger="state == 'reject'"/>
            </tree>
        </field>
    </record>

    <record id="view_joining_documents_form" model="ir.ui.view">
        <field name="name">view.joining.documents.form</field>
        <field name="model">joining.documents</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_confirmation,done"/>
                    <button name="action_submit" type="object" class="oe_highlight"
                            invisible="state not in ('draft')"
                            string="Submit"/>
                    <button name="action_confirm" type="object" class="oe_highlight"
                            invisible="state not in ('waiting_confirmation')"
                            string="Confirm"/>
                    <button name="action_reset" type="object"
                            invisible="state not in ('done','reject')"
                            string="Reset to Draft"/>
                    <button name="action_reject" type="object"
                            invisible="state not in ('waiting_confirmation')"
                            string="Reject"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"
                                   readonly="state not in ('draft')"/>
                            <field name="employee_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="state not in ('draft')"/>
                            <field name="document_type" readonly="True"/>
                            <field name="reference_file" readonly="True"/>
                            <field name="submitted_file" readonly="state not in ('draft')"/>
                        </group>
                        <group>
                            <field name="department_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="state not in ('draft')"/>
                            <field name="job_position_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="state not in ('draft')"/>
                            <field name="company_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="True"/>
                            <field name="joining_date" readonly="state not in ('draft')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subject" name="subject">
                            <field name="subject" widget="html" readonly="state not in ('draft')"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_joining_documents" model="ir.actions.act_window">
        <field name="name">Joining Documents</field>
        <field name="res_model">joining.documents</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
            id="menu_joining_documents_new"
            name="Joining Documents"
            parent="hr.menu_hr_employee_payroll"
            action="action_joining_documents"
            sequence='7'/>


</odoo>
