<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="joining_documents_tree_view" model="ir.ui.view">
        <field name="name">joining.documents.tree</field>
        <field name="model">joining.documents</field>
        <field name="arch" type="xml">
            <tree string="Employee Joining Document" default_order="sequence">
                <field name="join_doc_id" column_invisible="True"/>
                <field name="sequence" column_invisible="True"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_position_id"/>
                <field name="joining_date"/>
                <field name="state" widget='badge' decoration-info="state == 'waiting_confirmation'"
                       decoration-success="state =='done'" decoration-danger="state == 'reject'"/>
            </tree>
        </field>
    </record>

    <record id="view_joining_documents_form" model="ir.ui.view">
        <field name="name">view.joining.documents.form</field>
        <field name="model">joining.documents</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_confirmation,done"/>
                    <button name="action_submit" type="object" class="oe_highlight"
                            invisible="state not in ('draft')"
                            string="Submit"/>
                    <button name="action_confirm" type="object" class="oe_highlight"
                            invisible="state not in ('waiting_confirmation')" groups="hr.group_hr_user"
                            string="Confirm"/>
                    <button name="action_reset" type="object" groups="hr.group_hr_user"
                            invisible="state not in ('done','reject')"
                            string="Reset to Draft"/>
                    <button name="action_reject" type="object" groups="hr.group_hr_user"
                            invisible="state not in ('waiting_confirmation')"
                            string="Reject"/>
                    <button name="action_send_document_by_email" type="object"
                            invisible="document_type not in ('bgv','it_declaration','ebp_claim')"
                            string="Send Mail"/>
                    <!--                    <button name="action_send_it_declaration_by_email" type="object"-->
                    <!--                            invisible="document_type not in ('it_declaration')"-->
                    <!--                            string="Send Mail"/>-->
                    <!--                    <button name="action_send_ebp_claim_form_by_email" type="object"-->
                    <!--                            invisible="document_type not in ('ebp_claim')"-->
                    <!--                            string="Send Mail"/>-->
                    <button name="action_print_document"
                            type="object"
                            string="Print"
                            class="btn-primary" groups="hr.group_hr_manager"
                            invisible="state not in ('waiting_confirmation','done')"
                    />
                </header>
                <sheet>
                    <!--                    <div class="oe_button_box" name="button_box">-->
                    <!--                        <button class="oe_stat_button" type="object" string="Referral Form"-->
                    <!--                                invisible="document_type not in ('emp_ref_check')"-->
                    <!--                                name="action_open_related_candidate" icon="fa-user-plus">-->
                    <!--                        </button>-->
                    <!--                    </div>-->
                    <group>
                        <group>
                            <field name="name"
                                   readonly="state not in ('draft')"/>
                            <field name="employee_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="1"/>
                            <field name="document_type" readonly="True"/>
                            <field name="reference_filename" invisible="1"/>
                            <field name="reference_file" filename="reference_filename"
                                   invisible="document_type not in ('it_declaration','gmc','ebp_claim')"
                                   readonly="True"/>
                            <field name="submitted_file" filename="submitted_filename"
                                   invisible="document_type not in ('it_declaration','bgv','ebp_claim')"
                                   readonly="state not in ('draft')"/>
                            <field name="submitted_filename" invisible="1"/>
                            <field name="join_doc_id" invisible="1" />
                            <field name="sequence" invisible="1" />
                        </group>
                        <group>
                            <field name="department_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="state not in ('draft')"/>
                            <field name="job_position_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="state not in ('draft')"/>
                            <field name="company_id" options="{'no_quick_create':True,'no_create': True,}"
                                   readonly="True"/>
                            <field name="contact_id"
                                   invisible="document_type not in ('it_declaration','ebp_claim','bgv')" readonly="True"
                                   options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="joining_date" readonly="state in ('done')" groups="hr.group_hr_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subject" name="subject">
                            <field name="subject" widget="html" readonly="state not in ('draft')"/>
                        </page>
                        <page string="GMC GPA Details" invisible="document_type not in ('gmc')">
                            <group>
                                <group>
                                    <field name="emp_code"/>
                                    <field name="dependent_name"/>
                                    <field name="relationship"/>
                                    <field name="dob"/>
                                    <field name="age"/>
                                    <field name="gender"/>
                                    <field name="tax_entity" options="{'no_quick_create':True,'no_create': True,}"/>
                                    <field name="location"/>
                                </group>
                                <group>
                                    <field name="email" widget="email"/>
                                    <field name="contact_no" widget="phone"/>
                                    <field name="doj"/>
                                    <field name="insurance_type"/>
                                    <field name="sum_insured_gmc"/>
                                    <field name="sum_insured_gpa"/>
                                    <field name="insurance_status"/>
                                </group>
                            </group>
                            <group>
                                <field name="remarks"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="joining_documents_search_view" model="ir.ui.view">
        <field name="name">joining.documents.search</field>
        <field name="model">joining.documents</field>
        <field name="arch" type="xml">
            <search string="Employee Joining Documents">
                <!-- Filters -->
                <filter string="Waiting Confirmation" name="waiting_confirmation"
                        domain="[('state', '=', 'waiting_confirmation')]"/>
                <filter string="Done" name="done_filter"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Rejected" name="rejected_filter"
                        domain="[('state', '=', 'reject')]"/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter string="Employee" name="group_by_state"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="State" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_by_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Job Position" name="group_by_job_position"
                            context="{'group_by': 'job_position_id'}"/>
                </group>

                <!-- Search Fields -->
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_position_id"/>
                <field name="joining_date"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="action_joining_documents" model="ir.actions.act_window">
        <field name="name">Joining Documents</field>
        <field name="res_model">joining.documents</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
            id="menu_joining_documents_new"
            name="Joining Documents"
            parent="hr.menu_hr_employee_payroll"
            action="action_joining_documents"
            sequence='7'/>


</odoo>
