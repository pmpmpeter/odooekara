<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pre_employment_referral_report" model="ir.actions.report">
        <field name="name">Pre Employment Referral Report</field>
        <field name="model">preemp.check</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_extended.print_employment_referral_report</field>
        <field name="report_file">hr_extended.print_employment_referral_report</field>
        <field name="print_report_name">'%s' % (object.candidate_name)</field>
        <field name="binding_model_id" ref="hr_extended.model_preemp_check"/>
        <field name="binding_type">report</field>
    </record>

    <template id="print_employment_referral_report">
        <t t-call="web.basic_layout">
            <div class="page">
                Candidate Name: object.candidate_name
                Date: object.date
                Location: object.location
                Name of Referee: object.referee_id.name
            </div>
        </t>
    </template>
</odoo>