<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pre_employment_reference_check_form" model="ir.ui.view">
        <field name="name">pre.employment.reference.check.form</field>
        <field name="model">preemp.check</field>
        <field name="arch" type="xml">
            <form string="Pre Employment Reference Check">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="to_submit,done"/>
                    <button name="action_done" type="object" string="Mark as Done" class="btn-primary"
                            invisible="state in 'done'"/>
                    <button string="Print" type="action"
                            name="%(hr_extended.pre_employment_referral_report)d" class="btn-primary"/>
                    <button name="action_send_form_pdf_mail" type="object" string="Send by Email" class="oe_highlight"
                            invisible="state not in ('done')"/>
                </header>
                <sheet>
                    <group string="Candidate Details">
                        <field name="candidate_name" required="True" readonly="True"/>
                        <field name="date" readonly="True"/>
                        <field name="location" readonly="state in 'done'"/>
                    </group>
                    <notebook>
                        <page string="Referee Details">
                            <group string="Referee Details">
                                <field name="referee_id" readonly="True"/>
                                <field name="referee_phone" widget="phone" readonly="state in 'done'"/>
                                <field name="referee_email" widget="email" readonly="state in 'done'"/>
                                <field name="referee_title" readonly="state in 'done'"/>
                                <field name="referee_relationship" readonly="state in 'done'"/>
                            </group>
                        </page>
                        <page string="Comments">
                            <group string="Comments">
                                <field name="technical_skills_comments" readonly="state in 'done'"/>
                                <field name="job_duties_comments" readonly="state in 'done'"/>
                                <field name="professional_skills_comments" readonly="state in 'done'"/>
                            </group>
                        </page>
                        <page string="Professional Attributes">
                            <group string="Candidate Evaluation: Competencies and Professional Attributes">
                                <field name="integrity_resources" readonly="state in 'done'"/>
                                <field name="integrity_interactions" readonly="state in 'done'"/>
                                <field name="responsibility_productivity" readonly="state in 'done'"/>
                                <field name="maturity_composure" readonly="state in 'done'"/>
                                <field name="adaptability" readonly="state in 'done'"/>
                            </group>
                        </page>
                        <page string="Additional Comments">
                            <group string="Additional Comments">
                                <field name="additional_comments" readonly="state in 'done'"/>
                                <field name="other_comments" readonly="state in 'done'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pre_employment_reference_check_tree" model="ir.ui.view">
        <field name="name">pre.employment.reference.check.tree</field>
        <field name="model">preemp.check</field>
        <field name="arch" type="xml">
            <tree string="Candidate Reference Checks">
                <field name="candidate_name"/>
                <field name="date"/>
                <field name="referee_id"/>
                <field name="location"/>
                <field name="state" widget='badge' decoration-info="state == 'to_submit'"
                       decoration-success="state =='done'"/>
            </tree>
        </field>
    </record>

    <record id="view_pre_emp_form_search" model="ir.ui.view">
        <field name="name">pre.emp.form.search</field>
        <field name="model">preemp.check</field>
        <field name="arch" type="xml">
            <search>
                <filter string="To Submit" name="to_submit" domain="[('state', '=', 'to_submit')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>

                <group expand="0" string="Group By">
                    <filter string="Referee" name="group_by_referee_id" context="{'group_by':'referee_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by':'date'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                </group>

                <field name="candidate_name" string="Name"/>
                <field name="referee_id" string="Referee"/>
            </search>
        </field>
    </record>

    <record id="action_pre_employment_reference_check" model="ir.actions.act_window">
        <field name="name">Pre Employment Reference Check</field>
        <field name="res_model">preemp.check</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_pre_employment_reference_check_tree"/>
        <field name="search_view_id" ref="view_pre_emp_form_search"/>
        <field name="target">current</field>
        <field name="context">
            {
            'search_default_done': 1
            }
        </field>

    </record>

    <menuitem
            id="menu_pre_employ_reference_check"
            name="Pre Employee Reference Check"
            action="action_pre_employment_reference_check"
            groups="hr.group_hr_user"
            parent="hr.menu_hr_employee_payroll"
            sequence="6"
    />

</odoo>

