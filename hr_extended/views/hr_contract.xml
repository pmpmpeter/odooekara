                            <field name="monthly_performance_incentive_month" invisible="1" readonly="0" force_save="1"/>
                            <field name="variable_pay_per_month" readonly="0" force_save="1"/>
                            <field name="performance_linked_pay_month" invisible="1" readonly="0" force_save="1"/>
                            <field name="sub_total_c_per_month" readonly="0" force_save="1" invisible="1"/>
                            <field name="total_salary_per_month" readonly="0" force_save="1"/>
                        </group>
                        <group>
