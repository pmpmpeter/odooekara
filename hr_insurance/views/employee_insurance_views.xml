<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        hr insurance form view-->
    <record id="hr_insurance_view_form" model="ir.ui.view">
        <field name="name">hr.insurance.view.form</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <form string="Employee Insurance">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="policy_coverage"/>
                            <label for="date_from" string="Policy Period"/>
                            <div>
                                <field name="date_from" class="oe_inline"
                                       on_change="1"
                                       modifiers="{'readonly': [['state', 'not in', ['draft']]], 'required': true}"/>
                                -
                                <field name="date_to" class="oe_inline"
                                       modifiers="{'readonly': [['state', 'not in', ['draft']]], 'required': true}"/>
                            </div>
                        </group>
                        <group>
                            <field name="policy_id" options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="sum_insured"/>
                            <field name="amount"/>
                            <field name="company_id" options="{'no_quick_create':True,'no_create': True,'no_open': True}"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <!--        hr insurance tree view-->
    <record id="hr_insurance_view_tree" model="ir.ui.view">
        <field name="name">hr.insurance.view.tree</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <tree string="Employee Insurance">
                <field name="employee_id"/>
                <field name="policy_id"/>
                <field name="policy_coverage"/>
                <field name="sum_insured"/>
                <field name="amount"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>
    <!--        hr insurance action-->
    <record id="hr_insurance_action"
            model="ir.actions.act_window">
        <field name="name">Employee Insurance</field>
        <field name="res_model">hr.insurance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                You haven't created any policy yet.
            </p>
        </field>
    </record>
    <!--        hr insurance menu-->

    <menuitem id="insurance_management_menu" name="Insurance Management"
              groups="base.group_user" parent="hr.menu_hr_employee_payroll"
              sequence="10"/>

    <menuitem id="hr_insurance_menu"
              parent="hr_insurance.insurance_management_menu" name="Insurance"
              action="hr_insurance_action" groups="base.group_user"
              sequence="1"/>

<!--    <menuitem id="hr_insurance_menu" action="hr_insurance_action" name="Insurance" sequence="1"-->
<!--              parent="hr_insurance.menu_human_resources_configuration_insurance"-->
<!--    />-->

</odoo>
