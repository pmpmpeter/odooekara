<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="%(get_payroll_for_the_month)d" string="Payroll For The Month" type="action"
                        class="oe_highlight"/>
            </header>
        </field>
    </record>
    <record id="view_excel_report_wizard_form" model="ir.ui.view">
        <field name="name">pf.report.wizard.form</field>
        <field name="model">pf.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Download PF Report">
                <group>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                    <field name="company_id" readonly="1"/>
                </group>
                <footer>
                    <button name="generate_excel_report" string="Download" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pf_action_report" model="ir.actions.act_window">
        <field name="name">Download PF Report</field>
        <field name="res_model">pf.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pf_report" action='pf_action_report' name="PF Report" parent="hr_payroll.menu_hr_payroll_report"/>
</odoo>
