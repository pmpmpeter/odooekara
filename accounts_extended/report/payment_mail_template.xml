<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_template_data_payment_receipt_1" model="mail.template">
        <field name="name">Payment: Payment Receipt Mail</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="subject">{{ object.company_id.name }} Payment Receipt (Ref {{ object.name or 'n/a' }})</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="description">Sent manually to customer when clicking on 'Send receipt by email' in payment action
        </field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="box-sizing:border-box; margin: 0px; padding: 0px; font-size: 13px;">

                    Dear <t t-out="object.partner_id.name or ''"></t>,
                    <br/>
                    <br/>

                    Thank you for your payment.
                    Here is your payment receipt
                    <span style="font-weight:bold;" t-out="(object.name or '').replace('/', '-') or ''"></span>
                    amounting to
                    <span style="font-weight:bold;"
                          t-out="format_amount(object.amount, object.currency_id) or ''"></span>.
                    <br/>
                    <br/>

                    <t t-if="object.reconciled_bill_ids">
                        Below are the bill references and dates:
                        <br/>
                        <br/>
                        <ul style="padding-left: 15px;">
                            <t t-foreach="object.reconciled_bill_ids" t-as="bill">
                                <li>
                                    <span style="font-weight:bold;" t-out="bill.ref or ''"></span>
                                    —
                                    <span style="font-weight:bold;"
                                          t-out="format_date(bill.invoice_date) if bill.invoice_date else ''">
                                    </span>
                                </li>
                            </t>
                        </ul>
                    </t>

                    <br/>

                    Do not hesitate to contact us if you have any questions.
                    <br/>
                    <br/>

                    Best regards,
                    <br/>
                    <br/>

                    <t t-if="not is_html_empty(user.signature)">
                        <t t-out="user.signature or ''"></t>
                    </t>

                </p>
            </div>

        </field>
        <field name="report_template_ids" eval="[(4, ref('account.action_report_payment_receipt'))]"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
