<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
     <!-- Group: Tax Entity Head -->
        <record id="group_tax_entity_head" model="res.groups">
            <field name="name">Tax Entity Head</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Group for Tax Entity Head.</field>
        </record>

        <!-- Group: Tax Entity Director -->
        <record id="group_tax_entity_director" model="res.groups">
            <field name="name">Tax Entity Director</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Group for Tax Entity Director.</field>
        </record>

        <record id="record_rule_company_restrict_cash_management" model="ir.rule">
            <field name="name">Restrict Access to Own Company</field>
            <field name="model_id" ref="model_cash_management"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
