<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_management_form" model="ir.ui.view">
        <field name="name">cash.management.form</field>
        <field name="model">cash.management</field>
        <field name="arch" type="xml">
            <form string="Cash Requirement Report">
                <header>
                    <field name="approval_status" widget="statusbar" statusbar_visible="draft,to approve,approved"/>
                </header>
                <sheet>
                     <div class="oe_title">
                        <h1>
                            <field name="name"  readonly="1" placeholder="Draft"/>
                        </h1>
                    </div>
                    <group>

                        <field name="approval_status" invisible="1"/>
                        <group>
                            <field name="create_uid" string="Created By" readonly="1" options="{'no_open':True,'no_create': True}"/>
                            <field name="create_date" string="Created Date" readonly="1"/>
                            <field name="submitted_name" invisible='1'/>
                            <field name="submitted_file" filename = 'submitted_name' readonly="approval_status in ('approved','to approve')"/>
                            <field name="submit_by" readonly='1' force_save='1' options="{'no_open':True,'no_create': True}"/>
                            <field name="submitted_date" readonly="1"/>
                             <field name="approved_file" readonly='1' filename='approved_name' invisible="approval_status in ('draft','to approve')"/>
                            <field name="approved_by" readonly="1" options="{'no_open':True,'no_create': True}" invisible="approval_status in ('draft','to approve')"/>
                            <field name="approved_date" readonly="1" invisible="approval_status in ('draft','to approve')"/>
                            <field name="approved_name" invisible='1' readonly="1"/>

                        </group>
                        <group>
                            <field name="tax_entity" readonly="approval_status in ('draft','approve')"/>
                            <field name="tax_entity_1" required="tax_entity == 'both' or tax_entity == 'entity1'" readonly="approval_status in ('approved')" invisible="tax_entity not in ('entity1','both')" options="{'no_open':True,'no_create': True,}"/>
                            <field name="tax_entity_1_amount" required="tax_entity == 'both' or tax_entity == 'entity1'" readonly="approval_status in ('approved')" invisible="tax_entity not in ('entity1','both')"/>
                            <field name="tax_entity_2" required="tax_entity == 'both' or tax_entity == 'entity2'" readonly="approval_status in ('approved')" invisible="tax_entity not in ('entity2','both')" options="{'no_open':True,'no_create': True,}"/>
                            <field name="tax_entity_2_amount" required="tax_entity == 'both' or tax_entity == 'entity2'" readonly="approval_status in ('approved')" invisible="tax_entity not in ('entity2','both')"/>
                            <field name="approval_state" readonly="1"/>
                            <field name="approval_document" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revision Remarks" invisible='not revision_reason'>
                            <field name='revision_reason' force_save='1' readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'always'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cash_management_tree" model="ir.ui.view">
        <field name="name">cash.management.tree</field>
        <field name="model">cash.management</field>
        <field name="arch" type="xml">
            <tree string="Cash Requirement Report">
                <field name="name"/>
                <field name="create_uid"/>
                <field name="submit_by"/>
                <field name="approval_status"/>
                <field name="approved_by"/>
                <field name="approved_date"/>
            </tree>
        </field>
    </record>

    <record id="view_cash_management_search" model="ir.ui.view">
        <field name="name">cash.management.search</field>
        <field name="model">cash.management</field>
        <field name="arch" type="xml">
            <search string="Cash Requirement Report">
                <field name="name"/>
                <field name="create_uid"/>
                <field name="approval_status"/>
                <field name="approved_by"/>
                <field name="approved_date"/>
                
                <filter name="filter_draft" string="Draft" domain="[('approval_status', '=', 'draft')]"/>
                <filter name="filter_to_approve" string="To Approve" domain="[('approval_status', '=', 'to approve')]"/>
                <filter name="filter_approved" string="Approved" domain="[('approval_status', '=', 'approved')]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_create_uid" string="Created By" context="{'group_by': 'create_uid'}"/>
                    <filter name="group_approval_status" string="Status" context="{'group_by': 'approval_status'}"/>
                    <filter name="group_approved_by" string="Approved By" context="{'group_by': 'approved_by'}"/>
                </group>
            </search>
        </field>
    </record>
    
     <record id="action_cash_management" model="ir.actions.act_window">
        <field name="name">Cash Requirement Report</field>
        <field name="res_model">cash.management</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_cash_management_tree"/>
        <field name="search_view_id" ref="view_cash_management_search"/>
        <field name="help" type="html">
            <p>
                Use this menu to upload and validate your cash requirement report.
            </p>
        </field>
    </record>

    <menuitem id="menu_cash_management" 
              name="Cash Requirement Report"
              parent="account.menu_finance_reports"
              action="action_cash_management" 
             sequence="100"/>

        <record id="seq_cash_management" model="ir.sequence">
            <field name="name">Cash Requirement Report</field>
            <field name="code">cash.management</field>
            <field name="prefix">CM-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
</odoo>

