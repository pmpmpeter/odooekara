<?xml version="1.0" encoding="utf-8"?>
<odoo>

      <record id="view_account_payment_form_view_inherit" model="ir.ui.view">
            <field name="name">view.account.payment.form.view</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                 <field name="ref" position="after">
                    <field name='utr_number' invisible="payment_type != 'outbound' or (not show_partner_bank_account and not is_cheque_cleared)"/>
                </field>
                <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="cheque_format_id" invisible="show_partner_bank_account"/>
                <field name="is_cheque_cleared" invisible="show_partner_bank_account"/>
                <field name="cheque_cleared_date" invisible="show_partner_bank_account or not is_cheque_cleared"/>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <notebook>
                    <page name="cheque_details" string="Cheque Details" invisible="show_partner_bank_account">
                        <group>
                            <group>
                                <field name="sr_no"/>
                                <field name="cheque_number"/>
                                <field name="assigned_by"/>
                                <field name="managed_by"/>
                            </group>
                            <group>
                                <field name="authorised_by"/>
                                <field name="authorised_date"/>
                                <field name="comments"/>
                                <field name="towards"/>
                            </group>
                            <group>
                                <field name="trans_id"/>
                                <field name="sender_account_type"/>
                                <field name="beneficiary_account_type"/>
                                <field name="sender_receiver_info"/>
                                <field name="sms_email"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
                <field name="journal_id" position="before">
                    <field name="is_fund_requsiting" invisible="1"/>
                    <field name="approval_document" invisible="1"/>
                    <field name="x_need_approval" invisible="1"/>
                    <field name="x_has_request_approval" invisible="1"/>
                    <field name="is_contra_payment" invisible="1"/>
                     <field name="approval_state" invisible="is_contra_payment or (payment_type == 'inbound' and not is_fund_requsiting)"/>
                    <field name="reason_approved" invisible="not is_fund_requsiting" readonly="1"/>
                </field>
                <xpath expr="//button[@name='action_post']" position="replace">
                        <button name="action_post" string="Confirm" type="object" class="oe_highlight" invisible="payment_type != 'inbound' or state != 'draft' or is_fund_requsiting" data-hotkey="q"/>
                        <button name="action_post" string="Confirm" type="object" class="oe_highlight" invisible="payment_type != 'outbound' or state != 'approved'" data-hotkey="q"/>
                        <button name="action_post" string="Confirm" type="object" class="oe_highlight" invisible="not is_fund_requsiting or state != 'approved'" data-hotkey="q"/>
                </xpath>
                <xpath expr="//button[@name='action_draft']" position="replace">
                        <button name="action_draft" string="Reset To Draft" type="object" class="btn btn-secondary" invisible="state != 'cancel' or x_has_request_approval" groups="account.group_account_invoice" data-hotkey="w"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_batch_payment_form_inherited" model="ir.ui.view">
        <field name="name">account.batch.payment.view.form.inherit.odoo.print.cheque</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id"
               ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_export_payment_details_xlsx"
                        string="Export to Excel"
                        type="object"
                        class="oe_highlight"/>
                 <button name="action_print_batch_payment_pdf"
                                type="object"
                                string="Print Cheque PDF"
                                class="btn-primary"
                                icon="fa-print"/>
                  <button name="action_open_mail_wizard"
                        string="Send Mail"
                        type="object"
                        class="btn-primary"/>

            </header>
            <xpath expr="//field[@name='name']" position="after">
                <field name="cheque_format_id"/>
            </xpath>
            <xpath expr="//page[@name='batch_content']" position="after">
                    <page name="check_details" string="Check Details">
                        <group>
                            <group>
                                <field name="cheque_number"/>
                                <field name="authorised_by"/>
                                <field name="authorised_date"/>
                            </group>
                            <group>

                                <field name="towards"/>
                            </group>
                        </group>
                    </page>
            </xpath>

            <xpath expr="//page/field/tree/field[@name='state']" position="before">
                <field name="is_cheque_cleared" column_invisible=""/>
                <field name="cheque_cleared_date" column_invisible=""/>
                <field name="utr_number" optional='hide'/>
            </xpath>
        </field>
    </record>
</odoo>
