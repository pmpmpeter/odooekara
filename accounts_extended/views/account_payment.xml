<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_supplier_payment_tree_inherited" model="ir.ui.view">
        <field name="name">view.account.payment.tree.view.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="payment_type" column_invisible="1"/>
                <field name="show_partner_bank_account" column_invisible="1"/>
                <field name="cheque_number" optional="show"
                       invisible="show_partner_bank_account or payment_type != 'outbound'"/>

            </field>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_view" model="ir.ui.view">
        <field name="name">view.account.payment.form.view</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_check_printing.view_account_payment_form_inherited"/>
        <field name="arch" type="xml">
            <button name='print_checks' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </button>
        </field>
    </record>

    <record id="view_account_payment_form_view_inherit" model="ir.ui.view">
        <field name="name">view.account.payment.form.view</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name='utr_number' invisible="state not in  ('approved','posted') or (payment_type =='inbound' and not is_fund_requsiting) or
                        (not show_partner_bank_account and not is_cheque_cleared)"/>
                <field name='old_utr_number' invisible='1'/>
            </field>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="type" invisible="payment_type != 'outbound'"/>
                <field name="partner_bank_id" string="Vendor Bank Account"
                       options="{'no_quick_create':True,'no_create': True}"
                       context="{'default_partner_id': partner_id, 'display_account_trust': True}"
                       invisible="show_partner_bank_account or partner_type != 'supplier' or is_internal_transfer or payment_type == 'inbound'"
                       required="require_partner_bank_account and not is_internal_transfer"/>
                <field name="partner_cl_balance" readonly='1' force_save='1' invisible="payment_type != 'outbound'"/>
                <field name="closing_balance" readonly='1' force_save='1' invisible="payment_type != 'outbound'"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="cheque_format_id" invisible="show_partner_bank_account or payment_type != 'outbound'"
                       options="{'no_open':True,'no_create': True}"/>
                <field name="is_cheque_cleared" invisible="show_partner_bank_account or payment_type != 'outbound'"/>
                <field name="cheque_cleared_date" invisible="show_partner_bank_account or not is_cheque_cleared"/>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <notebook>
                    <page name="cheque_details" string="Cheque Details"
                          invisible="show_partner_bank_account or payment_type != 'outbound'">
                        <group>
                            <group>
                                <field name="sr_no"/>
                                <field name="cheque_number"/>
                                <field name="assigned_by" options="{'no_open':True,'no_create': True}"/>
                                <field name="managed_by" options="{'no_open':True,'no_create': True}"/>
                            </group>
                            <group>
                                <field name="authorised_by" options="{'no_open':True,'no_create': True}"/>
                                <field name="authorised_date"/>
                                <field name="comments"/>
                                <field name="towards"/>
                            </group>
                            <group>
                                <field name="trans_id" options="{'no_open':True,'no_create': True}"/>
                                <field name="sender_account_type" options="{'no_open':True,'no_create': True}"/>
                                <field name="beneficiary_account_type" options="{'no_open':True,'no_create': True}"/>
                                <field name="sender_receiver_info"/>
                                <field name="sms_email"/>
                            </group>
                        </group>
                    </page>
                    <page name="Approval Comments" invisible="not is_fund_requsiting">
                        <field name="reason_approved" invisible="not is_fund_requsiting" readonly="1"/>
                    </page>
                </notebook>
            </xpath>
            <field name="journal_id" position="before">
                <field name="is_fund_requsiting" invisible="1"/>
                <field name="approval_document" invisible="1"/>
                <field name="x_need_approval" invisible="1"/>
                <field name="x_has_request_approval" invisible="1"/>
                <field name="is_contra_payment" invisible="1"/>
                <field name="approval_state"
                       invisible="is_contra_payment or (payment_type == 'inbound' and not is_fund_requsiting)"/>
            </field>
            <xpath expr="//button[@name='action_post']" position="replace">
                <button name="action_post" string="Confirm" type="object" class="oe_highlight"
                        invisible="payment_type != 'inbound' or state != 'draft' or is_fund_requsiting"
                        data-hotkey="q"/>
                <button name="action_post" string="Confirm" type="object" class="oe_highlight"
                        invisible="payment_type != 'outbound' or state != 'approved'" data-hotkey="q"/>
                <button name="action_post" string="Confirm" type="object" class="oe_highlight"
                        invisible="not is_fund_requsiting or state != 'approved'" data-hotkey="q"/>
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="replace">
                <button name="action_draft" string="Reset To Draft" type="object" class="btn btn-secondary"
                        invisible="state != 'cancel' or x_has_request_approval" groups="account.group_account_invoice"
                        data-hotkey="w"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_update_utr_number" string="Update UTR Number" type="object" class="oe_highlight"
                        invisible="state != 'posted' or (payment_type =='inbound' and not is_fund_requsiting)"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </xpath>
            <xpath expr="//label[@for='amount']" position="before">
                <field name="payment_purchase_id" domain="[('partner_id','=',partner_id),('company_id','=',company_id),('state','in', ['done', 'purchase'])]"
                       readonly="state != 'draft'" invisible="payment_type != 'outbound'"/>
                <!-- <field name="payment_purchase_id" domain="[('partner_id','=',partner_id),('company_id','=',company_id),('state','in', ['done', 'purchase'])]"
                       readonly="state != 'draft'" invisible="payment_type != 'outbound'"
                       required="state != 'posted' and payment_type == 'outbound'"/> -->
            </xpath>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </xpath>

            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][1]" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][3]" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][4]" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </xpath>
            <field name="journal_id" position="attributes">
                <attribute name="options">{'no_quick_create':True,'no_create': True}</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_batch_payment_form_inherited" model="ir.ui.view">
        <field name="name">account.batch.payment.view.form.inherit.odoo.print.cheque</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id"
               ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_export_payment_details_xlsx"
                        string="Download Excel"
                        type="object"
                        class="oe_highlight"/>
                <button name="action_print_batch_payment_pdf"
                        type="object"
                        string="Print Cheque"
                        class="btn-primary"
                        icon="fa-print"/>
                <button name="action_open_mail_wizard"
                        string="Send Mail"
                        type="object"
                        class="btn-primary"/>

            </header>
            <xpath expr="//field[@name='name']" position="after">
                <field name="cheque_format_id" options="{'no_open':True,'no_create': True}"/>
            </xpath>
            <xpath expr="//page[@name='batch_content']" position="after">
                <page name="check_details" string="Cheque Details">
                    <group>
                        <group>
                            <field name="cheque_number"/>
                            <field name="authorised_by" options="{'no_open':True,'no_create': True}"/>
                            <field name="authorised_date"/>
                        </group>
                        <group>
                            <field name="towards"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//page/field/tree/field[@name='state']" position="before">
                <field name="is_cheque_cleared" column_invisible=""/>
                <field name="cheque_cleared_date" column_invisible=""/>
                <field name="utr_number" optional='hide'/>
            </xpath>
        </field>
    </record>
</odoo>
