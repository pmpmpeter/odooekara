<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_requirement_report_form" model="ir.ui.view">
        <field name="name">cash.requirement.report.form</field>
        <field name="model">cash.requirement.report</field>
        <field name="arch" type="xml">
            <form string="Cash Requirement Report">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    <button name="button_done" type="object" string="Done" invisible="1"/>
                    <button name="reset_to_draft" type="object" string="Reset Draft" invisible="1"/>
                    <button name="button_cancel" type="object" string="Cancel" invisible="1"/>

                </header>
                <sheet>
                        <div class="oe_title" width="100">
                        <h1>
                            <field name="name" placeholder="New"/>
                        </h1>
                    </div>
                        <group>
                            <group>
                                <field name="state" invisible="1"/>
                                <field name="create_uid"/>
                                <field name="create_date"/>
                                <field name="company_id" readonly="1"/>
                                <field name="start_date" readonly="state in 'done'"/>
                                <field name="end_date" readonly="state in 'done'"/>
                            </group>
                            <group>
                                <field name="requested_date" readonly="state in 'done'"/>
                                <field name="requested_by" options="{'no_quick_create':True,'no_create': True}" readonly="state in 'done'"/>
                                <field name="journal_bank" options="{'no_quick_create':True,'no_create': True}" readonly="state in 'done'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Cash Lines">
                                <group>
                                    <field name="available_balance" readonly="1" force_save="1" />
                                </group>

                                <field name="cash_requirement_lines" readonly="state in 'done'">
                                    <tree editable="bottom">
                                        <field name="cash_account" required="1" options="{'no_quick_create':True,'no_create': True}"/>
                                        <field name="partner_id" required="0" options="{'no_quick_create':True,'no_create': True}"/>
                                        <field name="requirement_month" required="1"/>
                                        <field name="amount" required="1"/>
                                        <field name="remarks"/>
                                    </tree>
                                </field>
                                <group>
                                    <field name="minimum_balance" readonly="state in 'done'"/>
                                    <field name="amount_total" readonly="1" force_save="1"/>
                                    <field name="total_fund_required" readonly="1" force_save="1"/>
                                </group>
                            </page>
                            <page string="Revision Remarks" invisible='not revision_reason'>
                                <field name='revision_reason' force_save='1' readonly="1"/>
                            </page>
                        </notebook>



                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'always'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cash_requirement_report_tree" model="ir.ui.view">
        <field name="name">cash.requirement.report</field>
        <field name="model">cash.requirement.report</field>
        <field name="arch" type="xml">
            <tree string="Cash Requirement Report">
                <field name="requested_date"/>
                <field name="requested_by"/>
                <field name="journal_bank"/>
                <field name="available_balance"/>
                <field name="minimum_balance"/>
                <field name="amount_total"/>
                <field name="total_fund_required"/>

            </tree>
        </field>
    </record>

    <record id="action_cash_requirement" model="ir.actions.act_window">
        <field name="name">Cash Requirement Request</field>
        <field name="res_model">cash.requirement.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>
                Create cash requirement request.
            </p>
        </field>
    </record>

    <menuitem id="menu_cash_requirement"
              name="Cash Requirement Request"
              parent="account.menu_finance_entries"
              action="action_cash_requirement"
              sequence="100"/>
</odoo>
