<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_pool_form" model="ir.ui.view">
        <field name="name">cash.pool.form</field>
        <field name="model">cash.pool</field>
        <field name="arch" type="xml">
            <form string="Cash Pool">
                <sheet>
                    <div class="oe_title" width="100">
                        <h1>
                            <field name="name" placeholder="New" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>

                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>


                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'always'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cash_pool_tree" model="ir.ui.view">
        <field name="name">cash.pool.tree</field>
        <field name="model">cash.pool</field>
        <field name="arch" type="xml">
            <tree string="Cash Pool">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

