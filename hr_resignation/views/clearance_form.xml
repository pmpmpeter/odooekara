<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="clearance_form_tree_view" model="ir.ui.view">
        <field name="name">clearance.form.tree</field>
        <field name="model">clearance.form</field>
        <field name="arch" type="xml">
            <tree string="Clearance Form">
                <field name="employee_id"/>
                <field name="designation_id"/>
                <field name="date_of_joining"/>
                <field name="last_working_day"/>
            </tree>
        </field>
    </record>
    <record id="clearance_form_view" model="ir.ui.view">
        <field name="name">clearance.form.form</field>
        <field name="model">clearance.form</field>
        <field name="arch" type="xml">
            <form string="Clearance Form">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,completed" nolabel="1"/>
                    <button name="clearance_form_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state == 'completed'"
                    />
                    <button name="clearance_form_complete" string="Complete" type="object"
                            class="oe_highlight" invisible="state == 'draft'"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"  options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="designation_id"  options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="date_of_joining"/>
                        </group>
                        <group>
                            <field name="department_id"  options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="last_working_day"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Handing Over Assets">
                            <field name="asset_ids">
                                <tree editable="bottom">
                                    <field name="asset_type"/>
                                    <field name="returned_to"  options="{'no_quick_create':True,'no_create': True,}"/>
                                    <field name="remarks"/>
                                    <field name="signature"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Clearance by Function Heads">
                            <field name="function_head_ids">
                                <tree editable="bottom">
                                    <field name="function"/>
                                    <field name="remarks"/>
                                    <field name="signature"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="clearance_form_action" model="ir.actions.act_window">
        <field name="name">Clearance Form</field>
        <field name="res_model">clearance.form</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Probation Review!
            </p>
        </field>
    </record>
    <menuitem id="clearance_form_menu"
              parent="hr_resignation.hr_resignation_menu_root"
              name="Clearance Form"
              action="clearance_form_action"
              sequence="8"
    />
</odoo>



