<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="email_template_resignation_confirm" model="mail.template">
        <field name="name">Resignation Confirmation</field>
        <field name="model_id" ref="model_hr_resignation"/>
        <field name="subject">Resignation Confirmed</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">${{ object.employee_parent_id.work_email }}</field>
        <field name="partner_to">${{ object.employee_parent_id.id }}</field>
        <field name="body_html">
            <![CDATA[
        <p>Dear <t t-esc="object.employee_parent_id.name"/>,</p>
        <p>This is to inform you that <t t-esc="object.employee_id.name"/> has submitted the resignation.</p>
        <p>The resignation request has been confirmed.</p>
        <p>Last working day: <t t-esc="object.expected_revealing_date"/></p>
        <p>Reason for Resignation: <t t-esc="object.reason"/></p>
        <p>Best regards,</p>
        <p><t t-esc="object.employee_id.name"/></p>
        ]]>
        </field>
    </record>

    <record id="email_template_resignation_approve" model="mail.template">
        <field name="name">Resignation Approval</field>
        <field name="model_id" ref="model_hr_resignation"/>
        <field name="subject">Resignation Approved</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">${{ object.employee_id.work_email }}</field>
        <field name="partner_to">${{ object.employee_id.id }}</field>
        <field name="body_html">
            <![CDATA[
            <p>Dear <t t-esc="object.employee_id.name"/>,</p>
            <p>Your resignation request has been approved.</p>
            <p>Last working day: <t t-esc="object.expected_revealing_date"/></p>
            <p>Reason for Resignation: <t t-esc="object.reason"/></p>
             <p>Thank you.</p>
            <p>Best regards,</p>
            <t t-esc="object.employee_parent_id.name"/>
            ]]>
        </field>
    </record>

    <record id="email_template_resignation_reject" model="mail.template">
        <field name="name">Resignation Rejection</field>
        <field name="model_id" ref="model_hr_resignation"/>
        <field name="subject">Resignation Rejected</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">${{ object.employee_id.work_email }}</field>
        <field name="partner_to">${{ object.employee_id.id }}</field>
        <field name="body_html">
            <![CDATA[
            <p>Dear <t t-esc="object.employee_id.name"/>,</p>
            <p>Your resignation request has been rejected.</p>
            <p>For more details, please contact HR.</p>
            <p>Thank you.</p>
            <p>Best regards,</p>
            <t t-esc="object.employee_parent_id.name"/>
            ]]>
        </field>
    </record>
</odoo>