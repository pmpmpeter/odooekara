<?xml version="1.0" ?>
<odoo >
    <record id="legal_notice_first_reminder_email_template" model="mail.template">
        <field name="name">Legal Notice First Reminder</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="subject">Reminder: Legal Notice First Reminder</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="body_html">
            <![CDATA[
        <p>Hello,</p>
        <p>This is a first reminder that the legal notice for project <b><t t-esc="object.name"/></b> is due.</p>
        <p>Please take the necessary actions.</p>
        ]]>
        </field>
    </record>
    <record id="legal_notice_second_reminder_email_template" model="mail.template">
        <field name="name">Legal Notice Second Reminder</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="subject">Reminder: Legal Notice Second Reminder</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="body_html">
            <![CDATA[
        <p>Hello,</p>
        <p>This is a second reminder that the legal notice for project <b><t t-esc="object.name"/></b> is due.</p>
        <p>Please take the necessary actions.</p>
        ]]>
        </field>
    </record>

    <record id="statuory_notice_first_reminder_email_template" model="mail.template">
        <field name="name">Statutory Notice First Reminder</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="subject">Reminder: Statutory Notice First Reminder</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="body_html">
            <![CDATA[
        <p>Hello,</p>
        <p>This is a first reminder that the Statutory notice for project <b><t t-esc="object.name"/></b> is due.</p>
        <p>Please take the necessary actions.</p>
        ]]>
        </field>
    </record>

    <record id="statuory_notice_second_reminder_email_template" model="mail.template">
        <field name="name">Statutory Notice Second Reminder</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="subject">Reminder: Statutory Notice Second Reminder</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello,
                    <br/>
                    <p>This is a second reminder that the Statutory notice for project <b><t t-esc="object.name"/></b> is due.</p>
                     <p>Please take the necessary actions.</p>
                </p>
            </div>
        </field>
    </record>

    <record id="legal_notice_creation_email_template" model="mail.template">
        <field name="name">Legal Notice Project Creation</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear Team,
                    <br/>
                    <p>A new project for legal notice has been created.Kindly check it.</p>
                    <p>Thank You.</p>

                </p>
            </div>
        </field>
    </record>

    <record id="statuory_notice_creation_email_template" model="mail.template">
        <field name="name">Statutory Notice Creation</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear Team,
                    <br/>
                    <p>A new project for Statutory notice has been created.Kindly check it</p>
                    <p>Thank You.</p>

                </p>
            </div>
        </field>
    </record>

</odoo>
